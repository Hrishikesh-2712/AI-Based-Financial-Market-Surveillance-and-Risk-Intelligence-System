# Copy this file to .env and fill in your values.

# "gemini" (cloud, needs GOOGLE_API_KEY, better quality) or
# "ollama" (fully local, no key needed, needs Ollama installed + a model pulled)
LLM_PROVIDER=gemini

# --- Gemini settings (only needed if LLM_PROVIDER=gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AQ.Ab8RN6LsWCcOhy17hf9Gg0bWrdRfW33UYJBBtfviuOC7XMmRSg
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama settings (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434